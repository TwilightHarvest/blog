---
import ThemeToggle from './ThemeToggle.astro';
import { SITE_TITLE } from '../consts';
import { url } from '../utils/posts';

const links = [
	{ href: url('posts/'), label: 'Posts' },
	{ href: url('tags/'), label: 'Tags' },
	{ href: url('about/'), label: 'About' },
];
---

<header>
	<a class="site-title" href={url('')}>{SITE_TITLE}</a>
	<nav>
		{links.map(({ href, label }) => <a href={href}>{label}</a>)}
		<ThemeToggle />
	</nav>
</header>

<style>
	header {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem 1.5rem;
		padding: 1.75rem 0 1rem;
		border-bottom: 1px solid var(--border);
	}
	a {
		color: var(--fg);
		text-decoration: none;
	}
	a:hover {
		color: var(--accent);
	}
	.site-title {
		font-weight: 650;
	}
	nav {
		display: flex;
		align-items: center;
		gap: 1.1rem;
		font-size: 0.95rem;
	}
</style>
